      "type": "string",
      "description": "\uc0ac\uc6a9\uc790 \uc774\uba54\uc77c"
    },
    "code": {
      "type": "string",
      "description": "6\uc790\ub9ac \uc778\uc99d \ucf54\ub4dc"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "\ub9cc\ub8cc \uc2dc\uac04 (\ubc1c\uc1a1 \ud6c4 5\ubd84)"
    },
    "consumed": {
