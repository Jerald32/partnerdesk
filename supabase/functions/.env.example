# Edge-only example. No actual credentials or generated secrets.
# Hosted Supabase supplies SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY. SUPABASE_PUBLISHABLE_KEYS JSON is also supported
# as an alternative to SUPABASE_ANON_KEY. Never use VITE_ for backend secrets.

# Set explicit comma-separated origins before hosting. No wildcard or paths.
PARTNERDESK_ALLOWED_ORIGINS=

# Hex encoding of 32-128 cryptographically random bytes; provision later.
# Keep stable across the lifetime of outstanding challenges. Never expose it.
PARTNERDESK_MFA_HMAC_SECRET=

# Email provider intentionally undecided. No working adapter or provider vars yet.
